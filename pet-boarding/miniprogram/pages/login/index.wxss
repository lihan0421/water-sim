.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  padding: 0 60rpx;
}
.logo {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
}
.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
}
.subtitle {
  font-size: 28rpx;
  color: #999;
  margin: 16rpx 0 80rpx;
}
.btn-login {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
}
